@namespace CineTerra.Components.Common

@if (IsOpen)
{
    <div @ref="_modalContainer"
         class="cinema-modal-backdrop"
         tabindex="-1"
         role="presentation"
         @onclick="HandleBackdropClick"
         @onkeydown="HandleKeyDown">

        <div class="cinema-modal cinema-modal--@Size @CssClass"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(Title is not null ? "cinema-modal-title" : null)"
             aria-label="@AriaLabel"
             tabindex="0"
             @onclick:stopPropagation="true"
             @attributes="AdditionalAttributes">

            <div class="cinema-modal__header">
                <div class="cinema-modal__title-group">
                    @if (!string.IsNullOrWhiteSpace(TelemetryStamp))
                    {
                        <span class="cinema-modal__stamp">@TelemetryStamp</span>
                    }
                    @if (TitleContent is not null)
                    {
                        @TitleContent
                    }
                    else if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h2 id="cinema-modal-title" class="cinema-modal__title">@Title</h2>
                    }
                </div>

                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="cinema-modal__close-btn"
                            aria-label="Close dialog"
                            @onclick="CloseAsync">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75">
                            <line x1="2" y1="2" x2="12" y2="12" />
                            <line x1="12" y1="2" x2="2" y2="12" />
                        </svg>
                    </button>
                }
            </div>

            <div class="cinema-modal__body">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <div class="cinema-modal__footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}
