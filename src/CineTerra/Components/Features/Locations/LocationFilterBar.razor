@namespace CineTerra.Components.Features.Locations

<div class="filter-bar">
    <!-- Top search & filter meta bar -->
    <div class="filter-bar__search-row">
        <div class="filter-bar__search-wrap">
            <span class="filter-bar__search-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="7" cy="7" r="5" />
                    <line x1="11" y1="11" x2="15" y2="15" />
                </svg>
            </span>
            <input type="text"
                   class="filter-bar__input"
                   placeholder="Search destinations, film titles, scenes, or regions..."
                   value="@Filter.SearchText"
                   @oninput="HandleSearchInput"
                   aria-label="Search filming locations" />
        </div>

        <div class="filter-bar__meta">
            <span class="filter-bar__counter">
                Showing <strong>@FilteredCount</strong> of <strong>@TotalCount</strong> Destinations
            </span>

            @if (Filter.IsActive)
            {
                <button type="button"
                        class="filter-bar__clear-btn"
                        @onclick="HandleClear"
                        aria-label="Clear all active filters">
                    <span aria-hidden="true">✕</span> Reset Filters
                </button>
            }
        </div>
    </div>

    <!-- Filter chips sections -->
    <div class="filter-bar__controls">
        <!-- Region Chips -->
        <div class="filter-group">
            <span class="filter-group__label">REGION</span>
            <div class="filter-group__chips" role="group" aria-label="Filter by region">
                <button type="button"
                        class="filter-chip @(!Filter.SelectedRegion.HasValue ? "filter-chip--active" : "")"
                        @onclick="() => SelectRegion(null)">
                    All
                </button>
                @foreach (var region in Enum.GetValues<Region>())
                {
                    var isSelected = Filter.SelectedRegion == region;
                    <button type="button"
                            @key="region"
                            class="filter-chip @(isSelected ? "filter-chip--active" : "")"
                            @onclick="() => SelectRegion(region)">
                        @region.ToFriendlyString()
                    </button>
                }
            </div>
        </div>

        <!-- Difficulty Chips -->
        <div class="filter-group">
            <span class="filter-group__label">TERRAIN</span>
            <div class="filter-group__chips" role="group" aria-label="Filter by terrain difficulty">
                <button type="button"
                        class="filter-chip @(!Filter.SelectedDifficulty.HasValue ? "filter-chip--active" : "")"
                        @onclick="() => SelectDifficulty(null)">
                    All
                </button>
                @foreach (var difficulty in Enum.GetValues<Difficulty>())
                {
                    var isSelected = Filter.SelectedDifficulty == difficulty;
                    <button type="button"
                            @key="difficulty"
                            class="filter-chip @(isSelected ? "filter-chip--active" : "")"
                            @onclick="() => SelectDifficulty(difficulty)">
                        @difficulty.ToFriendlyString()
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public LocationFilter Filter { get; set; } = new();

    [Parameter]
    public EventCallback OnFilterChanged { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int FilteredCount { get; set; }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        Filter.SearchText = e.Value?.ToString() ?? string.Empty;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task SelectRegion(Region? region)
    {
        Filter.SelectedRegion = Filter.SelectedRegion == region ? null : region;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task SelectDifficulty(Difficulty? difficulty)
    {
        Filter.SelectedDifficulty = Filter.SelectedDifficulty == difficulty ? null : difficulty;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task HandleClear()
    {
        Filter.Clear();
        await OnFilterChanged.InvokeAsync();
    }
}
